<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.ojalgo</groupId>
        <artifactId>ojalgo-extensions</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>ojalgo-ssclp</artifactId>
    <name>ojAlgo-ssclp</name>
    <description>ojAlgo and SSC-LP integration</description>
    <version>1.0.0-SNAPSHOT</version>
    <properties>
        <!-- This module must never be published. SSC-LP is GPLv3 with no linking exception, and this
             module is MIT like the rest of ojAlgo - see README.md. Building and installing locally is
             fine; deploying is not. Both switches are set: 'maven.deploy.skip' disables
             maven-deploy-plugin, 'skipPublishing' disables central-publishing-maven-plugin (which is
             what the parent actually deploys with). -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <skipPublishing>true</skipPublishing>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.ssclab</groupId>
            <artifactId>SSC-LP</artifactId>
            <version>4.7.8</version>
        </dependency>
    </dependencies>
</project>